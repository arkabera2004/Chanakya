<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Segoe UI,Arial,sans-serif;color:#1d2733;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;">
<tr><td align="center" style="padding:20px 10px;">
<table role="presentation" width="680" cellpadding="0" cellspacing="0" style="max-width:680px;background:#ffffff;border-radius:6px;">
  <tr><td style="padding:20px 24px;background:#101010;color:#ffffff;border-radius:6px 6px 0 0;border-bottom:3px solid #F0731A;">
    <div style="font-size:12px;letter-spacing:1px;opacity:.85;">CHANAKYA · WAYAM AI</div>
    <div style="font-size:20px;font-weight:600;margin-top:4px;">{% if total == 1 %}A notice you are tracking has changed{% else %}{{ total }} changes to notices you are tracking{% endif %}</div>
    {% if dry_run %}<div style="margin-top:6px;font-size:12px;background:#9c0006;display:inline-block;padding:2px 6px;">DRY RUN, not sent</div>{% endif %}
  </td></tr>
  <tr><td style="padding:14px 24px;font-size:14px;line-height:1.5;">
    The portal listing for {% if items|length == 1 %}this notice{% else %}these notices{% endif %} is different from the last time Chanakya read it. You are told about each change once.
  </td></tr>
  {% for o in items %}
  <tr><td style="padding:12px 24px;border-top:1px solid #e5e9ee;">
    <div style="font-size:12px;color:#5b6b7c;">{{ o.priority }} · {{ o.review }} · {{ o.platform }}</div>
    <div style="font-size:15px;font-weight:600;margin:2px 0;">{{ o.title }}</div>
    <div style="font-size:13px;">{{ o.organisation }}</div>
    <div style="font-size:13px;margin-top:4px;">Tender ID: <b>{{ o.tender_id }}</b> · Closes: <b>{{ o.closing }}</b>{% if o.days_left is not none %} ({{ o.days_left }} days left){% endif %}</div>
    {% for c in o.changes %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px;background:#fff7f0;border-left:3px solid #F0731A;">
      <tr><td style="padding:8px 10px;font-size:13px;line-height:1.5;">
        <div><b>{{ c.label }}</b> <span style="color:#5b6b7c;font-size:12px;">seen {{ c.at }}</span></div>
        <div>Was: <span style="color:#5b6b7c;">{{ c.old }}</span></div>
        <div>Now: <b>{{ c.new }}</b></div>
      </td></tr>
    </table>
    {% endfor %}
    {% if o.url %}<div style="font-size:13px;margin-top:8px;"><a href="{{ o.url }}" style="color:#0563c1;">Official listing</a> (search by Tender ID)</div>{% endif %}
  </td></tr>
  {% endfor %}
  <tr><td style="padding:14px 24px;font-size:11px;color:#5b6b7c;border-top:1px solid #e5e9ee;">
    Changes are found by comparing the portal listing with the copy Chanakya stored earlier. The corrigendum document itself
    is not read. Confirm every change and date on the official portal before acting.
  </td></tr>
</table>
</td></tr></table>
</body></html>
