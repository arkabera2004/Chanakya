# Copy to .env (never commit .env). Only secrets and deployment overrides live here.

# Ollama Cloud API key (https://ollama.com/settings/keys). Needed only when llm.mode: cloud.
OLLAMA_API_KEY=

# SMTP credentials (email.provider: smtp). Use an app password / service account.
CHANAKYA_SMTP_USERNAME=
CHANAKYA_SMTP_PASSWORD=

# Acquisition provider credentials (all optional; a provider with no key stays
# BLOCKED_BY_CREDENTIALS and disabled — see docs/CHANAKYA_UNIFIED_CRAWLING_FEATURE_INVENTORY.md).
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
BROWSERLESS_API_KEY=
ZYTE_API_KEY=

# Optional overrides
# CHANAKYA_CONFIG=/app/config/chanakya.yaml
# CHANAKYA_LLM_MODE=cloud
# CHANAKYA_EMAIL_TO=bd-team@example.com,solutions@example.com
# CHANAKYA_LOG_FORMAT=json        # one JSON object per log line for a log collector (default: text)
# CHANAKYA_DATABASE_URL=postgresql+psycopg://chanakya:${POSTGRES_PASSWORD}@postgres:5432/chanakya
# POSTGRES_PASSWORD=
# INSTALL_POSTGRES=true           # docker compose build: include the optional PostgreSQL driver in the image
